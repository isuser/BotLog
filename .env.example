# Copy to .env.local and fill in real values. Never commit .env files.

# Public URL of this Botlog instance
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...), safe in the browser; RLS protects data
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Secret key (sb_secret_..., replaces the legacy service_role key).
# Server-only: never add a NEXT_PUBLIC_ prefix. Used only for API key lookup and admin tasks.
SUPABASE_SECRET_KEY=sb_secret_replace-me

# Comma-separated list of emails allowed to sign in. Leave empty only on a public instance.
ALLOWED_EMAILS=you@example.com

# Private JWT signing key, used to sign short-lived tokens for agent API key requests.
# Supabase Cloud: generate with `pnpm exec supabase gen signing-key --algorithm ES256`, import it in
# Project Settings > JWT Keys as a standby key, then rotate to it. Paste the JWK here as one line.
# Self-hosted Supabase with a shared secret: put the JWT secret here instead. Server-only.
SUPABASE_JWT_SIGNING_KEY=

# Optional: requests per minute before the API answers 429. Per API key for agents, per person
# for the web app. Defaults: 120 and 600.
# RATE_LIMIT_API_KEY_PER_MINUTE=120
# RATE_LIMIT_USER_PER_MINUTE=600
